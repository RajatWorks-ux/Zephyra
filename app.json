{
  "expo": {
    "name": "Zephyra",
    "slug": "zephyra",
    "newArchEnabled": false,
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "scheme": "zephyra",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05050F"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05050F"
      },
      "package": "com.zephyra.app",
      "permissions": [
        "RECEIVE_SMS",
        "READ_SMS",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-font",
      ["expo-splash-screen", {
        "backgroundColor": "#05050F"
      }],
      "expo-background-fetch"
    ]
  }
}
