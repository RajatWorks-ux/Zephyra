{
  "expo": {
    "name": "Zephyra",
    "slug": "zephyra",
    "newArchEnabled": false,
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "scheme": "zephyra",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05050F"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05050F"
      },
      "package": "com.zephyra.app",
      "permissions": [
        "RECEIVE_SMS",
        "READ_SMS",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "ios": {},
    "plugins": [
      "expo-font",
      ["expo-splash-screen", { "backgroundColor": "#05050F" }],
      "expo-background-fetch",
      "expo-secure-store"
    ],
    "extra": {
      "EXPO_PUBLIC_APP_VERSION": "2.0.0",
      "EXPO_PUBLIC_OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
      "EXPO_PUBLIC_NVIDIA_TTS_BASE_URL": "https://integrate.api.nvidia.com/v1"
    }
  }
}

