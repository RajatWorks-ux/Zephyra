# ── ZEPHYRA — PHASE 2 ENVIRONMENT ───────────────────────────────────────────
# 
# IMPORTANT: These are the ONLY env vars needed now.
# All API keys (GROQ, NVIDIA) are stored on the USER'S DEVICE via expo-secure-store.
# Appwrite config is hardcoded in src/services/appwriteConfig.ts
# R2 video URLs are hardcoded in src/services/videoCache.ts
#
# The old SUPABASE and NVIDIA keys below have been removed intentionally.
# ────────────────────────────────────────────────────────────────────────────

# Public app config (safe to commit)
EXPO_PUBLIC_APP_VERSION=2.0.0
EXPO_PUBLIC_GROQ_BASE_URL=https://api.groq.com/openai/v1
EXPO_PUBLIC_NVIDIA_TTS_BASE_URL=https://integrate.api.nvidia.com/v1

# ⬇ OLD KEYS — REMOVED (no longer needed — replaced by user SecureStore keys)
# EXPO_PUBLIC_SUPABASE_URL=...         ← DELETED
# EXPO_PUBLIC_SUPABASE_ANON_KEY=...    ← DELETED
# EXPO_PUBLIC_NVIDIA_API_KEY_1=...     ← DELETED (user provides own GROQ keys)
